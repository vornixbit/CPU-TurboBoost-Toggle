<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Turbo Toggle"
           Manufacturer="TurboToggle"
           Version="$(var.Version)"
           UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890"
           InstallerVersion="500"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Turbo Toggle is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="Main" Title="Turbo Toggle" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Turbo Toggle">
        <Component Id="MainExe" Guid="B2C3D4E5-F6A7-8901-BCDE-F12345678901">
          <File Id="TurboToggleExe" Source="$(var.SourcePath)\TurboToggle-portable.exe" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppProgramMenuDir" Name="Turbo Toggle">
        <Component Id="AppShortcut" Guid="C3D4E5F6-A7B8-9012-CDEF-123456789012">
          <Shortcut Id="AppStartMenuShortcut"
                    Name="Turbo Toggle"
                    Description="System-tray toggle for Intel Turbo Boost"
                    Target="[INSTALLFOLDER]TurboToggle-portable.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveAppProgramMenuDir" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\TurboToggle" Name="installed" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <ComponentRef Id="MainExe" />
    </ComponentGroup>
    <ComponentGroup Id="Shortcuts" Directory="AppProgramMenuDir">
      <ComponentRef Id="AppShortcut" />
    </ComponentGroup>
  </Package>
</Wix>
