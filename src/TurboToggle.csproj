<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>1.0.3</Version>
    <Company>TurboToggle</Company>
    <Copyright>© 2026 TurboToggle</Copyright>
    <Product>Turbo Toggle</Product>
    <Title>Turbo Toggle</Title>
    <Description>System-tray toggle for Intel Turbo Boost (processor performance boost mode).</Description>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugType Condition="'$(Configuration)' != 'Release'">embedded</DebugType>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <Target Name="PruneRuntimePackAssets" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.Filename)' == 'System.Windows.Forms.Design'
                    or '%(ResolvedFileToPublish.Filename)' == 'createdump'
                    or '%(ResolvedFileToPublish.Filename)' == 'mscordbi'
                    or '%(ResolvedFileToPublish.Filename)' == 'mscorrc'
                    or '%(ResolvedFileToPublish.Filename)' == 'clrgc'
                    or '%(ResolvedFileToPublish.Filename)' == 'clrgcexp'
                    or '%(ResolvedFileToPublish.Filename)' == 'clretwrc'
                    or '%(ResolvedFileToPublish.Filename)' == 'Microsoft.DiaSymReader.Native.amd64'
                    or $([System.String]::Copy('%(ResolvedFileToPublish.Filename)').StartsWith('mscordaccore'))" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.Filename)' == 'TurboToggle'
                    and '%(ResolvedFileToPublish.Extension)' == '.xml'" />
    </ItemGroup>
  </Target>

</Project>
